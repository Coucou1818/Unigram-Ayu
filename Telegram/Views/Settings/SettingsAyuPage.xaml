<Page
    x:Class="Telegram.Views.Settings.SettingsAyuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Telegram.Controls"
    xmlns:common="using:Telegram.Common"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer Padding="24,12,24,24">
            <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">

                <!-- 页面主标题 -->
                <TextBlock Text="Prism / Ayu 增强功能" Style="{StaticResource TitleTextBlockStyle}" FontWeight="SemiBold" Margin="0,8,0,8" />

                <!-- 1. 幽灵模式卡片组 -->
                <controls:HeaderedControl Header="幽灵模式 (Ghost Mode)">
                    <CheckBox Content="开启全局隐身模式"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.GhostModeActive, Mode=TwoWay}" />
                    <CheckBox Content="发送消息已读确认 (关闭后阅读消息不留双勾)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.SendReadMessages, Mode=TwoWay}" />
                    <CheckBox Content="无痕浏览故事 (关闭后查看他人动态不留访客记录)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.SendReadStories, Mode=TwoWay}" />
                    <CheckBox Content="广播在线状态 (关闭后保持最近上线时间)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.SendOnlinePackets, Mode=TwoWay}" />
                    <CheckBox Content="广播正在输入状态 (关闭后打字上传不提示对方)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.SendUploadProgress, Mode=TwoWay}" />
                </controls:HeaderedControl>

                <!-- 2. 防撤回与编辑记录卡片组 -->
                <controls:HeaderedControl Header="防撤回与历史追踪 (Anti-Recall)">
                    <CheckBox Content="保存被撤回的消息"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.SaveDeletedMessages, Mode=TwoWay}" />
                    <CheckBox Content="被撤回消息半透明显示 (以 65% 半透明突出区分)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.SemiTransparentDeletedMessages, Mode=TwoWay}" />
                    <CheckBox Content="保存消息编辑历史记录 (查看修改前的原始版本)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.SaveMessagesHistory, Mode=TwoWay}" />
                </controls:HeaderedControl>

                <!-- 3. 本地会员特权与去广告 -->
                <controls:HeaderedControl Header="本地特权与界面净化 (Privileges)">
                    <CheckBox Content="解锁本地 Premium 特权 (本地解锁大贴纸与表情特权)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.LocalPremium, Mode=TwoWay}" />
                    <CheckBox Content="屏蔽频道赞助广告 (彻底过滤底部广告推荐)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.DisableAds, Mode=TwoWay}" />
                    <CheckBox Content="主播隐私防窥模式 (模糊隐藏手机号与内部 ID)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.StreamerMode, Mode=TwoWay}" />
                </controls:HeaderedControl>

                <!-- 4. 多引擎翻译增强 -->
                <controls:HeaderedControl Header="消息翻译引擎 (Translation Provider)">
                    <controls:SettingsButton Content="翻译服务提供商">
                        <controls:SettingsButton.Badge>
                            <ComboBox SelectedIndex="{x:Bind ProviderSelectedIndex, Mode=TwoWay}" Width="180">
                                <ComboBoxItem Content="Telegram 官方" />
                                <ComboBoxItem Content="Google 翻译 (免Key)" />
                                <ComboBoxItem Content="Yandex 翻译" />
                                <ComboBoxItem Content="微软 Bing / Edge" />
                                <ComboBoxItem Content="OpenAI 兼容接口" />
                            </ComboBox>
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <Grid Background="{ThemeResource SettingsItemBackground}" Padding="16,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Header="OpenAI Base URL" Text="{x:Bind ViewModel.OpenAIBaseUrl, Mode=TwoWay}" Margin="0,4" />
                        <PasswordBox Grid.Row="1" Header="OpenAI API Key" Password="{x:Bind ViewModel.OpenAIApiKey, Mode=TwoWay}" Margin="0,4" />
                        <TextBox Grid.Row="2" Header="模型名称 (Model)" Text="{x:Bind ViewModel.OpenAIModel, Mode=TwoWay}" Margin="0,4" />
                    </Grid>
                </controls:HeaderedControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
