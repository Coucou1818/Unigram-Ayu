<Page
    x:Class="Telegram.Views.Settings.SettingsAyuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Telegram.Controls"
    xmlns:common="using:Telegram.Common"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer Padding="24,12,24,24">
            <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">

                <!-- 页面主标题 -->
                <TextBlock Text="PrismGram+ 增强功能设置" Style="{StaticResource TitleTextBlockStyle}" FontWeight="SemiBold" Margin="0,8,0,8" />

                <!-- 1. 幽灵模式核心特性 -->
                <controls:HeaderedControl Header="幽灵模式 (Ghost essentials)">
                    <CheckBox Content="开启全局幽灵模式 (Ghost Mode)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.GhostModeActive, Mode=TwoWay}" />
                    <CheckBox Content="互动时自动标记已读 (Read on Interact - 发送消息或表情时标记已读)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.MarkReadAfterAction, Mode=TwoWay}" />
                    <CheckBox Content="上报消息已读确认 (关闭后看消息绝不给对方双勾)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.SendReadMessages, Mode=TwoWay}" />
                    <CheckBox Content="上报故事动态浏览 (Story Ghost Mode - 无痕查看动态不留访客记录)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.SendReadStories, Mode=TwoWay}" />
                    <CheckBox Content="上报实时在线数据包 (关闭后对外隐匿在线状态)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.SendOnlinePackets, Mode=TwoWay}" />
                    <CheckBox Content="上报正在输入与上传进度 (关闭后对方看不到“正在输入...“)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.SendUploadProgress, Mode=TwoWay}" />
                </controls:HeaderedControl>

                <!-- 2. 间谍模式：防撤回与历史追踪 -->
                <controls:HeaderedControl Header="防撤回与历史追踪 (Spy essentials)">
                    <CheckBox Content="保存被撤回的消息 (Save Deleted Messages)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.SaveDeletedMessages, Mode=TwoWay}" />
                    <CheckBox Content="保存消息编辑历史 (Save Edits History - 记录修改前的内容)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.SaveMessagesHistory, Mode=TwoWay}" />
                    <CheckBox Content="被撤回消息半透明显示 (以 55% 透明度突出区分)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.SemiTransparentDeletedMessages, Mode=TwoWay}" />
                    <CheckBox Content="保存并实时记录最后上线时间 (Save Last Online Time - 突破对方隐藏)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.SaveLastOnlineTime, Mode=TwoWay}" />
                </controls:HeaderedControl>

                <!-- 3. 本地大会员与特权增强 -->
                <controls:HeaderedControl Header="本地会员特权与去广告 (Other / Premium)">
                    <CheckBox Content="解锁本地 Telegram Premium 大会员特权 (加速上传下载与贴纸特权)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.LocalPremium, Mode=TwoWay}" />
                    <CheckBox Content="彻底过滤频道赞助商广告 (Disable Ads)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.DisableAds, Mode=TwoWay}" />
                    <CheckBox Content="显示账号详细信息 (Show Peer ID • 包含 DC 数据中心与注册时间)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.ShowPeerDetails, Mode=TwoWay}" />
                </controls:HeaderedControl>

                <!-- 4. 消息过滤与通用净化 -->
                <controls:HeaderedControl Header="通用设置与消息过滤 (General)">
                    <CheckBox Content="过滤 Zalgo 乱码与字符炸弹 (Filter Zalgo)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.FilterZalgo, Mode=TwoWay}" />
                    <CheckBox Content="屏蔽打开链接安全警告弹窗 (Disable Open Link Warning)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.DisableOpenLinkWarning, Mode=TwoWay}" />
                    <CheckBox Content="屏蔽类似频道推荐 (Disable Similar Channels)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.DisableSimilarChannels, Mode=TwoWay}" />
                    <CheckBox Content="关闭故事动态展示 (Disable Stories)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.DisableStories, Mode=TwoWay}" />
                    <CheckBox Content="主播防窥模式 (Streamer Mode - 隐藏手机号与敏感信息)"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.StreamerMode, Mode=TwoWay}" />
                </controls:HeaderedControl>

                <!-- 5. 消息多引擎翻译设置 -->
                <controls:HeaderedControl Header="翻译设置 (Translate)">
                    <controls:SettingsButton Content="翻译服务提供商 (Translation Provider)">
                        <controls:SettingsButton.Badge>
                            <ComboBox SelectedIndex="{x:Bind ProviderSelectedIndex, Mode=TwoWay}" Width="190">
                                <ComboBoxItem Content="Telegram 官方" />
                                <ComboBoxItem Content="Google 翻译 (内置高速端点)" />
                                <ComboBoxItem Content="Yandex 翻译" />
                                <ComboBoxItem Content="微软 Bing 翻译" />
                                <ComboBoxItem Content="OpenAI 兼容接口" />
                            </ComboBox>
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <Grid Background="{ThemeResource SettingsItemBackground}" Padding="16,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Header="OpenAI Base URL" Text="{x:Bind ViewModel.OpenAIBaseUrl, Mode=TwoWay}" Margin="0,4" />
                        <PasswordBox Grid.Row="1" Header="OpenAI API Key" Password="{x:Bind ViewModel.OpenAIApiKey, Mode=TwoWay}" Margin="0,4" />
                        <TextBox Grid.Row="2" Header="模型名称 (Model)" Text="{x:Bind ViewModel.OpenAIModel, Mode=TwoWay}" Margin="0,4" />
                    </Grid>
                </controls:HeaderedControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
